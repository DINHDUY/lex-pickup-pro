  "variables": {
    "frontendOrigin": "[format('https://{0}', parameters('frontendHost'))]",
    "backendImageResolved": "[parameters('backendImage')]",
    "frontendImageResolved": "[parameters('frontendImage')]"
  },
  "resources": [
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
