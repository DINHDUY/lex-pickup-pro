{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.47.16.16243",
      "templateHash": "7261055604105742987"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the deployment."
      }
    },
    "appName": {
      "type": "string",
      "defaultValue": "lex-pickup-pro",
      "metadata": {
        "description": "Base name used for the Azure resources."
      }
    },
    "cosmosEndpoint": {
      "type": "string",
      "defaultValue": "https://dtranllc.documents.azure.com:443/",
      "metadata": {
        "description": "Existing Cosmos DB account endpoint. Do not create a new account."
      }
    },
    "cosmosKey": {
      "type": "securestring",
      "metadata": {
        "description": "Primary or secondary key for the existing Cosmos DB account."
      }
    },
    "cosmosDatabaseName": {
      "type": "string",
      "defaultValue": "clubs",
      "metadata": {
        "description": "Existing Cosmos database name."
      }
    },
    "cosmosContainerName": {
      "type": "string",
      "defaultValue": "club_data",
      "metadata": {
        "description": "Existing Cosmos container name."
      }
    },
    "frontendHost": {
      "type": "string",
      "defaultValue": "www.lex-pickup-pro.us",
      "metadata": {
        "description": "Frontend hostname, without scheme. Example: www.lex-pickup-pro.us"
      }
    },
    "backendImage": {
      "type": "string",
      "defaultValue": "ghcr.io/dinhduy/lex-pickup-pro/backend:latest",
      "metadata": {
        "description": "Explicit backend image reference for the GHCR image."
      }
    },
    "frontendImage": {
      "type": "string",
      "defaultValue": "ghcr.io/dinhduy/lex-pickup-pro/frontend:latest",
      "metadata": {
        "description": "Explicit frontend image reference for the GHCR image."
      }
    },
    "appEnvironment": {
      "type": "string",
      "defaultValue": "production",
      "metadata": {
        "description": "Production runtime environment value."
      }
    },
    "backendMinReplicas": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Minimum backend replicas in ACA."
      }
    },
    "backendMaxReplicas": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Maximum backend replicas in ACA."
      }
    },
    "frontendMinReplicas": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Minimum frontend replicas in ACA."
      }
    },
    "frontendMaxReplicas": {
      "type": "int",
      "defaultValue": 1,
      "metadata": {
        "description": "Maximum frontend replicas in ACA."
      }
    },
    "jwtSecret": {
      "type": "securestring",
      "metadata": {
        "description": "JWT secret used by the backend."
      }
    },
    "clubInviteCode": {
      "type": "string",
      "defaultValue": "LEX2026",
      "metadata": {
        "description": "Invitation code used to onboard club members. Must not be LEX2026 when registration is enabled."
      }
    },
    "registrationEnabled": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Allow self-service registration with the club invitation code. Keep false in production unless clubInviteCode is unique."
      }
    },
    "cosmosClubId": {
      "type": "string",
      "defaultValue": "lex-pickup",
      "metadata": {
        "description": "Single cluster ID used within Cosmos data documents."
      }
    }
