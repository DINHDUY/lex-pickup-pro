              },
              {
                "name": "CLUB_INVITE_CODE",
                "value": "[parameters('clubInviteCode')]"
              },
              {
                "name": "REGISTRATION_ENABLED",
                "value": "[if(parameters('registrationEnabled'), 'true', 'false')]"
              },
              {
                "name": "DEMO_ENABLED",
                "value": "false"
              }
            ]
          }
        },
        "template": {
