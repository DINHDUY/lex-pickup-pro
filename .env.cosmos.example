# Copy to .env.cosmos (git-ignored). Azure runtime: attach a managed identity.
DATABASE_PROVIDER=cosmos
COSMOS_ENDPOINT=https://YOUR-ACCOUNT.documents.azure.com:443/
COSMOS_DATABASE=lex_pickup_real
COSMOS_CONTAINER=club_data
COSMOS_CLUB_ID=lex-pickup
COSMOS_AUTH_MODE=managed_identity
COSMOS_MANAGED_IDENTITY_CLIENT_ID=
COSMOS_CONSISTENCY_LEVEL=Strong
COSMOS_EMULATOR=false
COSMOS_KEY=
COSMOS_MAX_DOCUMENTS=10000
COSMOS_MAX_SNAPSHOT_BYTES=32000000
STORAGE_RETRY_ATTEMPTS=4
APP_ENV=production
JWT_SECRET=replace-me
COOKIE_SECURE=true
FRONTEND_URL=https://club.example.com
CORS_ORIGINS=["https://club.example.com"]
SESSION_COOKIE_NAME=lex_session
DEMO_ENABLED=false
REGISTRATION_ENABLED=false
CLUB_INVITE_CODE=replace-with-random-invitation-code
WEB_PORT=8082
REMINDER_WEBHOOK_URL=
REMINDER_WEBHOOK_SECRET=
