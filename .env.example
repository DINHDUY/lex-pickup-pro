CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
CLUB_INVITE_CODE=LEX2026
REGISTRATION_ENABLED=true
DEMO_ENABLED=true
REMINDER_WEBHOOK_URL=
REMINDER_WEBHOOK_SECRET=
